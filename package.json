{
  "name": "mhy-plugin",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "cleanup:state": "node scripts/cleanup-mys-state.mjs",
    "check": "pnpm run \"/^(type-check|lint:check|format:check)$/\"",
    "type-check": "tsc --noEmit",
    "lint:check": "oxlint",
    "format:check": "oxfmt --check",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "dayjs": "1.11.21",
    "dotenv": "17.4.2",
    "got-scraping": "4.1.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "tsx": "4.23.1",
    "typescript": "7"
  }
}
