{
  "name": "mhy-plugin",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "pnpm run \"/^(type-check|lint:check|format:check)$/\"",
    "type-check": "tsc --noEmit",
    "lint:check": "oxlint",
    "format:check": "oxfmt --check",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "dayjs": "1.11.23",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
